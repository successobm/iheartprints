# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local sprint persistence
.data/

# Local acceptance artifacts — customer files, never committed
.local-acceptance/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

supabase/.temp/

# Local Phase 2B Harley calibration PNGs (customer assets — never commit)
.tmp-phase2b-harley/
.tmp-audit-harley/
.tmp-phase2c0-bakeoff/

# DTF Physical Calibration Phase 2B generated sheets (regenerate via script)
.tmp-dtf-physical-calibration/

# Sprint 2M Phase 2D research bake-off artifacts (local only)
research/phase-2d-bakeoff/outputs/
research/phase-2d-bakeoff/reports/

# Phase 2D/2E local research artifacts
research/phase-2d-bakeoff/sources/*.png
research/phase-2e-acceptance/acceptance-*.json
research/phase-2e-acceptance/run.log
.local-lab-assets/
