# Production-safe defaults for concept generation and asset storage.
# Production OpenAI generation remains blocked until a production-safe
# object-storage asset backend is implemented (e.g. supabase_storage or s3).
# Do not commit real credentials.

CONCEPT_GENERATION_PROVIDER=placeholder
ASSET_STORAGE_MODE=data_uri

# Optional — local/dev only. Never enable openai in production without a
# production-safe ASSET_STORAGE_MODE (not yet implemented).
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=

# --- Background generation worker (Sprint 2H Part 2B) ----------------------
# See docs/deployment/generation-worker.md for the full deployment guide.

# Shared secret the protected worker endpoint (POST /api/worker/generation)
# requires on every request, via `Authorization: Bearer <secret>` or an
# `X-Worker-Secret` header. Required in production — the endpoint fails
# closed (401) if unset there. Outside production, an unset value falls
# back to a well-known, clearly-labeled dev secret (see
# capabilities/worker-scheduler/worker-auth.ts) so local development works
# without configuring anything; set this explicitly to test the real path.
# WORKER_SECRET=

# How many queued/recoverable jobs a single worker run processes before
# stopping, even if more remain queued. Keeps one run (one HTTP call, one
# scheduler tick, one standalone-process loop iteration) bounded. Defaults
# to a small positive number if unset or invalid.
# MAX_GENERATION_JOBS_PER_RUN=5

# Milliseconds between heartbeat touches while a worker is actively running
# a job, and the default wake interval for the standalone worker process's
# scheduler loop. Defaults to 15000 (15s) if unset or invalid.
# WORKER_HEARTBEAT_INTERVAL=15000
