# Safe defaults for concept generation and asset storage.
# Real (OpenAI) generation stays disabled by default. Do not commit real
# credentials.
#
# supabase_storage is implemented (private design-assets bucket), but real
# generation must remain off until production configuration, migration/bucket
# setup, worker scheduling, and controlled live verification are complete.
# See ARCHITECTURE.md §21 and docs/deployment/generation-worker.md.

CONCEPT_GENERATION_PROVIDER=placeholder
ASSET_STORAGE_MODE=data_uri
CONCEPT_GENERATION_ENABLE_REAL=false

# Optional — local/dev only. Even with these set, production still requires
# CONCEPT_GENERATION_ENABLE_REAL=true, a production-safe ASSET_STORAGE_MODE
# (supabase_storage; s3 reserved/unimplemented), and a configured worker.
# Outside production, paid OpenAI image calls ALSO require
# ALLOW_PAID_IMAGE_GENERATION=true (Phase 2C0 spend guard).
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=
# Concept image quality (OpenAI): low | medium | high. Default medium.
# Never omit / never use auto — invalid values fail configuration.
# OPENAI_CONCEPT_IMAGE_QUALITY=medium
# Local/dev arming for paid concept image generation (not required in production):
# ALLOW_PAID_IMAGE_GENERATION=false

# --- Concept Evaluation (Sprint 2I Phase 2) --------------------------------
# Internal, advisory-only brief-alignment scoring recorded on each generated
# concept. Never blocks, hides, or ranks concepts for the customer — see
# ARCHITECTURE.md §5 (ConceptEvaluationCapability) and §13. Unlike concept
# generation, a misconfigured request here always falls back to the
# deterministic placeholder evaluator (safe in every environment, including
# production) rather than failing closed, because nothing customer-facing
# depends on it.

CONCEPT_EVALUATION_PROVIDER=placeholder

# Optional — reuses OPENAI_API_KEY above. Vision-capable chat model used to
# score a generated concept against the approved Design Brief.
# OPENAI_EVALUATION_MODEL=gpt-4o-mini

# --- Background generation worker ------------------------------------------
# See docs/deployment/generation-worker.md for the full deployment guide.

# Shared secret the protected worker endpoint (POST /api/worker/generation)
# requires on every request, via `Authorization: Bearer <secret>` or an
# `X-Worker-Secret` header. Required in production — the endpoint fails
# closed (401) if unset there. Outside production, an unset value falls
# back to a well-known, clearly-labeled dev secret (see
# capabilities/worker-scheduler/worker-auth.ts) so local development works
# without configuring anything; set this explicitly to test the real path.
# WORKER_SECRET=

# How many queued/recoverable jobs a single worker run processes before
# stopping, even if more remain queued. Keeps one run (one HTTP call, one
# scheduler tick, one standalone-process loop iteration) bounded. Defaults
# to a small positive number if unset or invalid.
# MAX_GENERATION_JOBS_PER_RUN=5

# Milliseconds between heartbeat touches while a worker is actively running
# a job, and the default wake interval for the standalone worker process's
# scheduler loop. Defaults to 15000 (15s) if unset or invalid.
# WORKER_HEARTBEAT_INTERVAL=15000

# --- Final Artwork / production reconstruction (Sprint 2M Phase 2E) --------
# Independent provider boundary for turning an approved concept into
# production-ready raster artwork. NOT coupled to OPENAI_API_KEY or any
# concept-generation/evaluation setting above. See ARCHITECTURE.md §13d.
#
# local (default, safe everywhere) — LocalRasterInterpolationProvider: a
#   local, deterministic geometric resample. No network call, no paid
#   request, no TOPAZ_API_KEY required.
# topaz — TopazTransparencyUpscaleProvider: real, paid, genuine 4x
#   super-resolution reconstruction (proven in the Sprint 2M Phase 2D
#   controlled bake-off; research/phase-2d-bakeoff/BAKEOFF_REPORT.md).
#   Requires TOPAZ_API_KEY. If topaz is requested without a key, the
#   FinalArtworkJob fails safely (never print_ready, never a silent
#   fallback to local interpolation).

FINAL_ARTWORK_PROVIDER=local

# Required only when FINAL_ARTWORK_PROVIDER=topaz. Server-only — never
# logged, never returned from an API route, never included in a customer
# snapshot.
# TOPAZ_API_KEY=
