{
  "name": "iheartprints",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "test": "node --test scripts/validate-migrations.test.mjs && node scripts/run-tests.mjs",
    "worker": "tsx scripts/run-generation-worker.ts",
    "worker:final-artwork": "tsx scripts/run-final-artwork-worker.ts",
    "verify": "npm run lint && npm run typecheck && npm run typecheck:tests && npm run validate:migrations && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "next": "16.3.0",
    "pngjs": "^7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "^14.0.1",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
